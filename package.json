{
  "name": "medroute",
  "private": true,
  "version": "1.0.0",
  "scripts": {
    "dev": "npx concurrently -k -n \"client,server\" -c \"blue,green\" \"npm run dev:client\" \"npm run dev:server\"",
    "dev:client": "npm run dev --prefix client",
    "dev:server": "npm run dev --prefix server",
    "start:server": "npm start --prefix server",
    "build": "npm run build --prefix client",
    "preview": "npm run preview --prefix client",
    "db:seed": "npm run db:seed --prefix server",
    "test:save": "curl -s http://localhost:8080/test-save"
  }
}
