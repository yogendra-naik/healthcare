PORT=8080
MONGODB_URI=mongodb://localhost:27017/medroute

GEMINI_API_KEY=your_gemini_api_key

# Auth
JWT_SECRET=use_a_long_random_string_in_production
JWT_EXPIRES_IN=7d

# Google Cloud Console → APIs & Services → Credentials → OAuth 2.0 Client ID (Web)
GOOGLE_CLIENT_ID=your_client_id.apps.googleusercontent.com

# Comma-separated. Include your Vercel URL(s), e.g. https://medroute.vercel.app
CORS_ORIGINS=http://localhost:5174,https://your-app.vercel.app
# Set true to allow any https://*.vercel.app preview deployment
ALLOW_VERCEL_PREVIEWS=true
